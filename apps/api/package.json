{
  "name": "api",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "pretest": "npm run test:db:push",
    "pretest:coverage": "npm run test:db:push",
    "test:db:push": "DATABASE_URL=\"file:./prisma/test.db\" prisma db push --skip-generate --accept-data-loss",
    "test": "DATABASE_URL=\"file:./prisma/test.db\" node --test --test-concurrency=1 --test-reporter=tap --test-reporter-destination=stdout",
    "test:coverage": "DATABASE_URL=\"file:./prisma/test.db\" node --test --test-concurrency=1 --experimental-test-coverage --test-reporter=tap --test-reporter-destination=stdout"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.4.1",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0"
  }
}

# connection_limit=1 avoids SQLite lock contention under concurrent writes —
# SQLite only supports one writer at a time, so a bigger pool just means
# more connections queuing for the same file lock.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Free key from https://console.groq.com/keys - powers the "Suggest Work"
# AI feature on the Intent screen. Leave unset to disable it (returns 503).
GROQ_API_KEY=

# Optional - defaults to openai/gpt-oss-20b. See available models at
# https://console.groq.com/docs/models
GROQ_MODEL=

# Server-side key with the Distance Matrix API enabled, from
# https://console.cloud.google.com/apis/credentials (requires billing
# enabled on the project). Powers real driving-time routing for plans
# created with "use accurate travel time" on. Separate from the frontend's
# VITE_GOOGLE_MAPS_API_KEY (apps/web/.env) - do not reuse that key here, and
# do not use this one client-side. Leave unset to always fall back to a
# straight-line distance estimate.
GOOGLE_MAPS_API_KEY=

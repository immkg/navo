// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Intent {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("active") // active, completed, not_required, archived
  priority    String   @default("medium") // low, medium, high
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workItems   Work[]
}

model Work {
  id                      String           @id @default(uuid())
  title                   String
  type                    String           @default("task") // task, decision, etc.
  status                  String           @default("todo") // todo, in_progress, done
  priority                String           @default("medium") // low, medium, high — independent of intent.priority
  energyLevel             String           @default("medium") // low, medium, high — how much energy this work takes
  durationMinutes         Int              @default(30)
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  intentId                String?
  intent                  Intent?          @relation(fields: [intentId], references: [id])

  contexts                Context[]
  locationOptions         LocationOption[]
  selectedLocationOptionId String?

  // Self-relations for dependencies (DAG)
  dependsOn               WorkDependency[] @relation("DependsOn")
  dependedBy              WorkDependency[] @relation("DependedBy")
  planStopWorks           PlanStopWork[]
}

model Location {
  id          String   @id @default(uuid())
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  placeId     String?   @unique
  provider    String?
  // Fetched from Google Places once, when the place is added (not at
  // search time) — see docs/AI notes in LocationOptionGroupsEditor.jsx.
  phoneNumber      String?
  rating           Float?
  ratingsCount     Int?
  // Display strings, e.g. ["Monday: 9:00 AM – 5:00 PM", ...].
  openingHoursText Json?
  // Structured periods (Google's opening_hours.periods shape) used to
  // compute a live "closes in X" / "opens at Y" status.
  openingPeriods   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationOptions LocationOption[] @relation("LocationOptionLocations")
  planStops       PlanStop[]
}

model LocationOption {
  id          String   @id @default(uuid())
  title       String?
  workId      String
  work        Work     @relation(fields: [workId], references: [id])
  locations   Location[] @relation("LocationOptionLocations")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkDependency {
  id          String   @id @default(uuid())
  
  workId      String
  work        Work     @relation("DependsOn", fields: [workId], references: [id], onDelete: Cascade)
  
  dependsOnId String
  dependsOn   Work     @relation("DependedBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([workId, dependsOnId])
}

model Context {
  id          String   @id @default(uuid())
  name        String
  type        String   // time, location, people, etc.

  workItems   Work[]
}

model Plan {
  id                     String   @id @default(uuid())
  title                  String?
  status                 String   @default("draft") // draft, active, completed, abandoned

  startAt                DateTime
  startLabel             String?
  startLatitude          Float?
  startLongitude         Float?

  endAt                  DateTime
  endLabel               String?
  endLatitude            Float?
  endLongitude           Float?

  useAccurateTravelTime  Boolean  @default(false)
  energyLevel            String   @default("high") // low, medium, high — how much energy the person planning has; "high" plans against everything equally

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  stops                  PlanStop[]
}

model PlanStop {
  id                  String    @id @default(uuid())
  planId              String
  plan                Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  locationId          String
  location            Location  @relation(fields: [locationId], references: [id])

  order               Int
  status              String    @default("planned") // planned, in_progress, done, skipped

  plannedArrivalAt    DateTime
  plannedDepartureAt  DateTime
  actualArrivalAt     DateTime?
  actualDepartureAt   DateTime?

  works               PlanStopWork[]
}

model PlanStopWork {
  id          String   @id @default(uuid())
  planStopId  String
  planStop    PlanStop @relation(fields: [planStopId], references: [id], onDelete: Cascade)

  workId      String
  // Cascades for the same reason WorkDependency's relations do: deleting a
  // work item (directly, or via its intent) must not be blocked by a
  // historical plan-stop assignment.
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  status      String   @default("planned") // planned, done, skipped

  @@unique([planStopId, workId])
}

// A saved shape for a recurring day (#84) — "weekday morning errands", a
// gym+market loop — so creating a new plan doesn't mean re-entering the
// same window/energy/routing setup every time. Deliberately holds no
// start/end coordinates or specific work items: those change day to day,
// but the window's duration and how it should be planned usually don't.
model PlanTemplate {
  id                     String   @id @default(uuid())
  name                   String
  durationMinutes        Int
  energyLevel            String   @default("high") // low, medium, high
  useAccurateTravelTime  Boolean  @default(false)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
